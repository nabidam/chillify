# Chillify deployment configuration.
# Copy to .env and edit before `docker compose up -d`.
# Invalid or missing values fail startup with a named configuration error
# before any migration runs.

# LAN port the nginx web service binds on the host (1-65535).
CHILLIFY_BIND_PORT=8787

# Absolute host paths. Both must exist, be normal writable filesystems,
# and be owned/writable by CHILLIFY_UID:CHILLIFY_GID.
# CHILLIFY_DATA_ROOT holds SQLite and recovery journals.
# CHILLIFY_MUSIC_ROOT holds MP3s and per-track artwork.
CHILLIFY_DATA_ROOT=/srv/chillify/data
CHILLIFY_MUSIC_ROOT=/srv/chillify/music

# Host identity that owns both mounted roots. Containers run as this identity.
CHILLIFY_UID=1000
CHILLIFY_GID=1000

# Operator-run Redis. Chillify never starts its own Redis service.
# Required for acquisition; its loss degrades downloads only.
REDIS_URL=redis://127.0.0.1:6379/3

# Key namespace for this deployment. Nonempty, no whitespace.
CHILLIFY_REDIS_PREFIX=chillify:

# URL-safe 32-byte Fernet key encrypting stored provider/proxy secrets.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up together with the data and music roots. A different key
# fails startup rather than discarding encrypted settings.
CHILLIFY_SECRET_KEY=

# Standard logging level for Rich stdout output.
CHILLIFY_LOG_LEVEL=INFO

# Same-origin only by default. List explicit LAN origins only if direct
# API access outside the nginx proxy is deliberately enabled.
CHILLIFY_ALLOWED_ORIGINS=

# Runtime mode. `production` is the only value for household use.
# `gate` binds deterministic fixture adapters and is refused unless both
# storage roots resolve beneath the repository .gate/ tree and
# CHILLIFY_REDIS_PREFIX begins with `chillify:gate:`.
CHILLIFY_ENV=production

# Fixture tree for gate runs only. Must resolve beneath the repository .gate/.
CHILLIFY_FIXTURE_ROOT=
