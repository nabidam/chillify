{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "frontend/**/*.ts",
      "frontend/**/*.tsx",
      "frontend/**/*.json",
      "frontend/**/*.css",
      "!frontend/src/api/generated.ts",
      "!frontend/dist",
      "!frontend/coverage",
      "!frontend/node_modules",
      "!frontend/package-lock.json",
      "!frontend/test-results",
      "!frontend/playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 96
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": { "recommended": true },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error"
      },
      "suspicious": {
        "noConsole": { "level": "error", "options": { "allow": [] } },
        "noExplicitAny": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useImportType": "error"
      }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "overrides": [
    {
      "includes": ["frontend/src/components/ui/**", "frontend/src/hooks/use-mobile.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off", "noDocumentCookie": "off" },
          "style": { "noNonNullAssertion": "off" },
          "correctness": { "useExhaustiveDependencies": "off" }
        }
      }
    },
    {
      "includes": ["frontend/src/styles/globals.css"],
      "linter": {
        "rules": { "complexity": { "noImportantStyles": "off" } }
      }
    }
  ]
}
